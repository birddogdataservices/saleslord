# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server-side only — never expose client-side

# ── Anthropic ────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY is no longer used — each user brings their own key via the setup page.
# ANTHROPIC_API_KEY=sk-ant-...

# Encryption secret for user API keys stored in the DB (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Keep this secret — losing it means all stored keys must be re-entered.
API_KEY_ENCRYPTION_SECRET=your-64-hex-char-secret-here

# ── Access control ───────────────────────────────────────────────────
ALLOWED_DOMAIN=yourcompany.com                     # Primary gate: only emails @this domain can sign in
NEXT_PUBLIC_ALLOWED_DOMAIN=yourcompany.com         # Passed to Google OAuth hd= param (client-safe)
# If ALLOWED_DOMAIN is unset, middleware falls back to the allowed_emails table.

# ── Rate limiting ────────────────────────────────────────────────────
DAILY_CALL_LIMIT=50                                # Runaway guard on metered Anthropic calls per user per rolling 24h (not a budget — BYOK). rep_profiles.daily_call_limit overrides per rep.

# ── Email ────────────────────────────────────────────────────────────
# Not needed. Invites and login links are sent by Supabase Auth
# (inviteUserByEmail / signInWithOtp), configured in the Supabase dashboard.
# No transactional email provider is installed.
# RESEND_API_KEY=re_...                            # Only if one is ever wired

# ── Cron ─────────────────────────────────────────────────────────────
CRON_SECRET=your-random-secret                     # Authenticates Vercel cron → /api/cron/refresh-all

# ── Stripe (wire when ready — the package is not installed) ──────────
# STRIPE_SECRET_KEY=sk_live_...                    # Server-side only
# STRIPE_WEBHOOK_SECRET=whsec_...                  # Server-side only
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...   # Safe to expose

# ── App URL ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
